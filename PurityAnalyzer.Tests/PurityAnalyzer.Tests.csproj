<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Early draft superseded by CallingGenericMethodsTests.cs; was never part of the build. -->
    <Compile Remove="IsPureAttributeOnMethod\CallingGenericMethods.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <!-- Test code is compiled against fixed .NET Framework 4.7.2 reference assemblies, independent of the
         runtime hosting the tests. The analyzer's knowledge base (Resources/*.txt) is written for .NET Framework. -->
    <PackageReference Include="Basic.Reference.Assemblies.Net472" Version="1.8.12" />
    <!-- FluentAssertions 8+ is under a commercial license; 7.x is the last Apache-2.0 version. -->
    <PackageReference Include="FluentAssertions" Version="[7.2.0,8.0.0)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Collections.Immutable built for netstandard2.0, used as a reference by tests that analyze code using ImmutableArray. -->
    <PackageDownload Include="System.Collections.Immutable" Version="[1.5.0]" />
    <None Include="$(NuGetPackageRoot)system.collections.immutable/1.5.0/lib/netstandard2.0/System.Collections.Immutable.dll"
          Link="TestReferences/System.Collections.Immutable.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PurityAnalyzer\PurityAnalyzer.csproj" />
    <ProjectReference Include="..\PurityAnalyzer.Tests.CompiledCsharpLib\PurityAnalyzer.Tests.CompiledCsharpLib.csproj" />
  </ItemGroup>

</Project>
