<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PurityAnalyzer.Vsix</RootNamespace>
    <AssemblyName>PurityAnalyzerVsix</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Key.snk</AssemblyOriginatorKeyFile>

    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <NoWarn>$(NoWarn);NU1608</NoWarn>

    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <!-- Visual Studio provides these assemblies at runtime. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" ExcludeAssets="runtime" />
    <!-- Compile against the Roslyn version the analyzer uses (5.0.0, shipped with VS 2026).
         Microsoft.VisualStudio.LanguageServices is only published up to 4.14 and pins Roslyn 4.14 exactly (NU1608). -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PurityAnalyzer\PurityAnalyzer.csproj" />
  </ItemGroup>

  <!-- VSIX packaging (pkgdef, .vsix container) is only available in Visual Studio's MSBuild. -->
  <Target Name="RequireVisualStudioMSBuild" BeforeTargets="PrepareForBuild" Condition="'$(MSBuildRuntimeType)' == 'Core'">
    <Error Text="PurityAnalyzer.Vsix must be built with Visual Studio 2026 or its MSBuild (msbuild.exe), not 'dotnet build'. To build and test the analyzer from the command line, use 'dotnet test PurityAnalyzer.Tests'." />
  </Target>

  <ItemGroup>
    <None Update="source.extension.vsixmanifest" SubType="Designer" />
    <Content Include="Resources\VSPackage.ico" />
    <EmbeddedResource Update="VSPackage.resx">
      <DependentUpon>VSPackage.cs</DependentUpon>
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
